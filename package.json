{
  "name": "devai-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run tailwind:watch\" \"ng serve --open\"",
    "build": "npm run tailwind:build && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tailwind:watch": "npx @tailwindcss/cli -i src/tailwind.css -o src/tailwind-compiled.css --watch",
    "tailwind:build": "npx @tailwindcss/cli -i src/tailwind.css -o src/tailwind-compiled.css"
  },
  "private": true,
  "packageManager": "npm@10.2.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
